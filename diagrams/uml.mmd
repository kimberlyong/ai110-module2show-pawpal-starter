classDiagram
    class OwnerInfo {
        +name: String
        +contact: String
        +workSchedule: String
        +restrictions: String
    }

    class PetInfo {
        +animal: String
        +breed: String
        +age: Integer
        +specialRequirements: String
        +feedingRequirements: String
    }

    class Task {
        +type: String
        +frequency: String
    }

    class DailyPlan {
        +organizeTasks()
    }

    OwnerInfo "1" --> "0..*" PetInfo : manages
    PetInfo "1" --> "0..*" Task : determines
    Task "1..*" --> "1" DailyPlan : builds
